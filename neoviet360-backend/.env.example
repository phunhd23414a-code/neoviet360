# NeoViet 360 Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend Origin (for CORS) - comma separated for multiple origins
FRONTEND_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,https://your-frontend.vercel.app"

# Additional trusted origins for production deployments (comma separated)
# Example: https://neoviet360-xxx.vercel.app,https://custom-domain.com
# TRUSTED_ORIGINS=""

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Zalo OAuth2
ZALO_APP_ID="your-zalo-app-id"
ZALO_APP_SECRET="your-zalo-app-secret"
ZALO_CALLBACK_URL="http://localhost:3001/api/auth/zalo/callback"

# Gemini AI
GEMINI_API_KEY="AIzaSy-your-gemini-api-key"

# Server
PORT=3001
NODE_ENV=development